---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BrainPreview from '../components/brain/BrainPreview.astro';
import { mailto } from '../lib/site';

const aiProjectMailto = mailto('AI project inquiry');

// Heroicons outline paths
const services = [
    {
        title: 'Functional Safety Engineering',
        icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
        items: ['ISO 26262 Functional Safety', 'Safety Concepts & Architecture', 'HARA, FTA, FMEA & SOTIF', 'Safety Requirements & Traceability'],
    },
    {
        title: 'Robotics & Machinery Safety',
        icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
        items: ['Machinery Risk Assessment', 'ISO 12100, ISO 13849 & IEC 62061', 'Safety-Related Sensing & Control', 'Safety Concepts & Validation Support'],
    },
    {
        title: 'Embedded Software & Systems Integration',
        icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
        items: ['Embedded C/C++ & Python', 'ROS 2 & Robotics Integration', 'Software & System Architecture', 'Hardware–Software Integration'],
    },
    {
        title: 'Systems Engineering & Architecture',
        icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
        items: ['System Requirements & Architecture', 'Technical Concept Development', 'Interface & Integration Engineering', 'Requirements Traceability'],
    },
    {
        title: 'AI Transformation & Integration',
        icon: 'M13 10V3L4 14h7v7l9-11h-7z',
        items: ['Agentic AI & Workflow Automation', 'Enterprise AI Integration', 'AI-Assisted Software Engineering', 'AI Deployment & Operations'],
    },
    {
        title: 'AI Governance & ISO 42001',
        icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
        items: ['ISO 42001-Aligned AI Management', 'AI Risk Assessment & Governance', 'Human Oversight & Controls', 'AI Lifecycle & Traceability'],
    },
];

const aiCapabilities = [
    { title: 'AI Agents & Automation', text: 'Custom agents connecting internal tools, knowledge bases, and business workflows.' },
    { title: 'AI-Native Engineering', text: 'Integrating AI coding agents and automated workflows into software development processes.' },
    { title: 'Enterprise Integration', text: 'Connecting AI systems with existing infrastructure, applications, and enterprise data.' },
    { title: 'Responsible AI Deployment', text: 'Security, risk management, human oversight, and ISO 42001-aligned governance.' },
];

// Selected engineering projects. The featured one gets the large card with its visual.
const featured = {
    name: 'BRAIN',
    subtitle: 'Persistent Memory for Project-Aware AI Agents',
    category: 'Internal R&D · Operational',
    description: 'A self-hosted, Git-native knowledge infrastructure that gives AI agents persistent, project-specific memory across complex engineering workflows.',
    tags: ['Grok Bot', 'MCP', 'Project Digital Twins', 'Knowledge Curation', 'Git & Markdown', 'Access Control'],
    link: { href: '/projects/brain', label: 'Explore BRAIN' },
};
const projects = [
    {
        name: 'Human-Robot Interface',
        badge: 'Open Source',
        description: 'An open-source robotics stack combining ESP32-S3 interface firmware, Jetson-based ROS 2 processing, and agent-platform integration for an extensible voice-enabled robotic companion.',
        tags: ['ROS 2', 'Jetson Orin', 'ESP32-S3', 'Python / C++'],
        link: { href: 'https://github.com/ovidiupescar/human-robot-interface', label: 'View on GitHub' },
    },
];
---

<Layout title="Fisherman Engineering | Functional Safety, Robotics & AI Engineering">
    <div class="relative min-h-screen flex flex-col">
        <SiteNav />

        <main class="flex-grow">
            <!-- Hero Section -->
            <section class="relative bg-midnight overflow-hidden">
                <!-- technical grid motif -->
                <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:48px_48px]"></div>
                <!-- signal halo glow, top-right -->
                <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-orange/20 blur-[120px]"></div>

                <div class="relative z-10 max-w-7xl mx-auto px-6 pt-28 pb-28 flex items-center gap-16">
                    <div class="max-w-3xl flex-1">
                        <div class="flex items-center gap-3 mb-8">
                            <span class="px-3 py-1 rounded-full border border-white/15 text-white/70 font-mono text-xs">EST. 2017</span>
                            <span class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-orange">
                                <span class="w-1.5 h-1.5 rounded-full bg-orange"></span>
                                Automotive · Robotics · Systems
                            </span>
                        </div>

                        <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05] mb-6">
                            Engineering Safety for<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-white/55">Automotive, AI &amp; Robotics.</span>
                        </h1>

                        <div class="w-16 h-1 rounded-full bg-orange mb-8"></div>

                        <p class="text-lg md:text-xl text-tech/80 max-w-2xl mb-10 leading-relaxed">
                            Functional safety and systems engineering for automotive, robotics, and autonomous systems — combining embedded software expertise with practical AI integration.
                        </p>

                        <div class="flex flex-wrap gap-4">
                            <a href={mailto()} class="px-7 py-3 bg-orange text-white font-semibold rounded-md hover:bg-orange/90 transition-colors inline-flex items-center gap-2">
                                Get in Touch <span class="font-mono" aria-hidden="true">-></span>
                            </a>
                            <a href="#services" class="px-7 py-3 border border-white/20 text-white font-semibold rounded-md hover:bg-white/5 transition-colors">
                                View Services
                            </a>
                        </div>
                    </div>

                    <!-- FE Signal Halo brand tile -->
                    <div class="hidden lg:flex shrink-0 items-center justify-center w-72 h-72 rounded-2xl bg-cool-white border border-white/10 shadow-2xl shadow-black/40">
                        <img src="/fe-icon.png" alt="Fisherman Engineering FE Signal Halo mark" class="w-44 h-44" />
                    </div>
                </div>
            </section>

            <!-- Services Grid -->
            <section id="services" class="py-24 px-6 bg-offwhite scroll-mt-16">
                 <div class="max-w-7xl mx-auto">
                    <div class="mb-14 max-w-2xl">
                        <div class="font-mono text-xs uppercase tracking-wider text-orange mb-3">// Services</div>
                        <h2 class="font-heading font-semibold text-navy text-3xl md:text-4xl tracking-tight">
                            Safety-critical engineering, end to end.
                        </h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {services.map((service) => (
                            <div class="group p-8 rounded-lg bg-white border border-border-mist hover:border-orange/60 hover:shadow-xl hover:shadow-navy/5 transition-all">
                                <div class="w-12 h-12 rounded-md bg-tech flex items-center justify-center text-navy mb-6 group-hover:bg-orange/10 group-hover:text-orange transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={service.icon} />
                                    </svg>
                                </div>
                                <span class="block w-8 h-0.5 rounded-full bg-orange mb-4"></span>
                                <h3 class="text-xl font-heading font-semibold text-navy mb-4">{service.title}</h3>
                                <ul class="space-y-3 text-steel">
                                    {service.items.map((item) => (
                                        <li class="flex items-start gap-3">
                                            <span class="w-1.5 h-1.5 mt-[9px] shrink-0 rounded-full bg-orange"></span>
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                 </div>
            </section>

            <!-- AI Transformation Section -->
            <section id="ai-transformation" class="py-20 px-6 bg-white border-y border-border-mist scroll-mt-16">
                <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
                    <div class="lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-wider text-orange mb-3">// AI Transformation</div>
                        <h2 class="font-heading font-semibold text-navy text-3xl md:text-4xl tracking-tight mb-6">
                            From AI Strategy to Production.
                        </h2>
                        <p class="text-steel leading-relaxed mb-8">
                            We help engineering and technology companies integrate AI into real-world workflows — from identifying high-value opportunities to building, deploying, and maintaining AI-powered systems.
                        </p>
                        <p class="font-mono text-sm text-navy mb-8">Built by engineers. Designed for production.</p>
                        <a href={aiProjectMailto} class="px-7 py-3 bg-orange text-white font-semibold rounded-md hover:bg-orange/90 transition-colors inline-flex items-center gap-2">
                            Discuss an AI Project <span class="font-mono" aria-hidden="true">-></span>
                        </a>
                    </div>

                    <ul class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-8 content-start">
                        {aiCapabilities.map((capability, i) => (
                            <li class="border-t border-border-mist pt-5">
                                <div class="font-mono text-xs text-orange mb-2" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
                                <h3 class="font-heading font-semibold text-navy text-lg mb-2">{capability.title}</h3>
                                <p class="text-steel text-sm leading-relaxed">{capability.text}</p>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>

            <!-- Engineering Leadership Section -->
            <section id="leadership" class="py-24 px-6 bg-offwhite scroll-mt-16">
                <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
                    <div class="lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-wider text-orange mb-3">// Engineering Leadership</div>
                        <h2 class="font-heading font-semibold text-navy text-3xl md:text-4xl tracking-tight">
                            Engineering expertise behind the technology.
                        </h2>
                    </div>

                    <div class="lg:col-span-3">
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-6">
                            <h3 class="font-heading font-semibold text-navy text-xl">Ovidiu Pescar</h3>
                            <span class="text-steel">Founder &amp; Engineering Consultant</span>
                            <span class="px-3 py-1 rounded-full border border-border-mist font-mono text-xs text-navy">15+ Years Engineering Experience</span>
                        </div>
                        <div class="space-y-4 text-steel leading-relaxed mb-8">
                            <p>
                                Over 15 years of experience in automotive and embedded systems engineering, including nine years focused on safety-critical development.
                            </p>
                            <p>
                                Professional experience spans BMW's ASIL D ADAS compute platforms, computer-vision systems, electronic steering, and safety-related robotics, with previous engineering and leadership roles at Continental, Ford, and thyssenkrupp.
                            </p>
                            <p>
                                Combining hands-on software development, systems architecture, functional safety, and technical project leadership, Ovidiu brings a rigorous engineering approach to complex systems and AI integration.
                            </p>
                        </div>
                        <a href="https://www.linkedin.com/in/ovidiupescar" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-semibold text-navy hover:text-orange transition-colors">
                            View LinkedIn Profile <span class="font-mono" aria-hidden="true">-></span>
                        </a>
                    </div>
                </div>
            </section>

            <!-- Selected Engineering Projects -->
            <section id="projects" class="pb-24 px-6 bg-offwhite scroll-mt-16" aria-labelledby="projects-heading">
                <div class="max-w-7xl mx-auto space-y-6">
                    <h2 id="projects-heading" class="font-mono text-xs uppercase tracking-wider text-orange"><span aria-hidden="true">// </span>Selected Engineering Projects</h2>

                    <article class="relative overflow-hidden rounded-xl bg-midnight grid grid-cols-1 lg:grid-cols-2">
                        <div class="relative z-10 p-8 md:p-12 flex flex-col justify-center">
                            <span class="self-start mb-5 px-3 py-1 rounded-full border border-white/15 text-tech/80 font-mono text-xs inline-flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-[#22c55e]" aria-hidden="true"></span>{featured.category}</span>
                            <h3 class="text-3xl md:text-4xl font-heading font-semibold text-white mb-2">{featured.name}</h3>
                            <p class="font-heading text-lg text-tech/90 mb-4">{featured.subtitle}</p>
                            <p class="text-tech/75 leading-relaxed mb-6">{featured.description}</p>
                            <ul class="flex flex-wrap gap-2 text-xs font-mono text-tech/70 mb-8" aria-label="Technologies and capabilities">
                                {featured.tags.map((tag) => <li class="px-3 py-1 rounded-full bg-white/5 border border-white/10">{tag}</li>)}
                            </ul>
                            <a href={featured.link.href} class="self-start px-6 py-3 bg-orange text-white font-semibold rounded-md hover:bg-orange/90 transition-colors inline-flex items-center gap-2">
                                {featured.link.label} <span class="font-mono" aria-hidden="true">-></span>
                            </a>
                        </div>
                        <a href={featured.link.href} class="block self-center p-4 lg:p-6" aria-label="Explore BRAIN">
                            <BrainPreview />
                        </a>
                    </article>

                    {projects.map((project) => (
                        <article class="relative overflow-hidden p-8 md:p-10 rounded-xl bg-midnight">
                            <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-orange/15 blur-[100px]"></div>
                            <div class="relative z-10 flex flex-col md:flex-row md:items-start md:justify-between gap-8">
                                <div class="max-w-2xl">
                                    <div class="flex flex-wrap items-center gap-3 mb-4">
                                        <h3 class="text-2xl md:text-3xl font-heading font-semibold text-white">{project.name}</h3>
                                        <span class="px-2 py-0.5 rounded-full bg-orange/15 border border-orange/30 text-xs font-mono text-orange">{project.badge}</span>
                                    </div>
                                    <p class="text-tech/75 leading-relaxed mb-6">{project.description}</p>
                                    <ul class="flex flex-wrap gap-2 text-xs font-mono text-tech/70" aria-label="Technologies">
                                        {project.tags.map((tag) => (
                                            <li class="px-3 py-1 rounded-full bg-white/5 border border-white/10">{tag}</li>
                                        ))}
                                    </ul>
                                </div>
                                <a href={project.link.href} target="_blank" rel="noopener noreferrer" class="shrink-0 self-start px-6 py-3 bg-orange text-white font-semibold rounded-md hover:bg-orange/90 transition-colors inline-flex items-center gap-2">
                                    {project.link.label} <span class="font-mono" aria-hidden="true">-></span>
                                </a>
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        </main>

        <SiteFooter />
    </div>
</Layout>
