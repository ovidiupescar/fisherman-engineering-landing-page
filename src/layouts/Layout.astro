---
interface Props {
	title: string;
    description?: string;
    image?: string;
    imageAlt?: string;
}

const {
    title,
    description = "Functional safety, systems engineering, embedded software, robotics safety, and AI transformation consulting for complex engineering environments.",
    image = '/fe-logo-stacked.png',
    imageAlt = 'Fisherman Engineering',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const wide = image !== '/fe-logo-stacked.png';
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Fisherman Engineering" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content={wide ? 'summary_large_image' : 'summary'} />
		<link rel="icon" type="image/png" href="/fe-icon.png" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-offwhite text-ink font-body antialiased selection:bg-orange selection:text-white">
		<slot />
	</body>
</html>
